{
  "name": "notes-desktop",
  "productName": "Notes",
  "version": "1.0.0",
  "description": "A considered Markdown workspace for Windows",
  "author": "Notes",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "build": "node scripts/build.cjs",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "npm run build && node tests/ui.cjs",
    "dist": "npm run build && electron-builder --win nsis portable --x64",
    "prepare": "node scripts/prepare.cjs"
  },
  "build": {
    "appId": "studio.notes.markdown",
    "productName": "Notes",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/icon.ico",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Notes",
      "artifactName": "Notes-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Notes-Portable-${version}-${arch}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown"
        ],
        "name": "Notes.Markdown",
        "description": "Markdown Document",
        "role": "Editor",
        "icon": "icon.ico"
      }
    ],
    "extraResources": [
      {
        "from": "assets/vendor/gh.exe",
        "to": "vendor/gh.exe"
      },
      {
        "from": "assets/vendor/LICENSE-GitHub-CLI.txt",
        "to": "vendor/LICENSE-GitHub-CLI.txt"
      }
    ]
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.3",
    "dompurify": "3.4.15",
    "highlight.js": "11.12.0",
    "marked": "18.0.14"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "png-to-ico": "3.0.2",
    "prettier": "3.9.8",
    "sharp": "0.35.4"
  }
}
